{
  "name": "univ_cm_mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npx react-native start",
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "build-android": "cd android && ./gradlew assembleRelease && cd ..",
    "build-ios": "cd ios && xcodebuild -workspace univ_cm_mobile.xcworkspace -scheme univ_cm_mobile -sdk iphoneos -configuration Release && cd ..",
    "lint": "eslint .",
    "test": "jest",
    "e2e-test": "detox test"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "^0.2.9",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "axios": "^1.3.4",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-config": "^1.4.6",
    "react-native-dotenv": "^3.2.0",
    "react-native-gesture-handler": "^2.4.2",
    "react-native-reanimated": "^3.3.0",
    "react-native-screens": "^3.10.0",
    "react-native-vector-icons": "^9.0.0",
    "react-redux": "^8.0.5",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/runtime": "^7.21.0",
    "babel-jest": "^29.4.0",
    "detox": "^20.5.0",
    "eslint": "^8.38.0",
    "jest": "^29.4.1",
    "metro-react-native-babel-preset": "^0.73.6",
    "metro-react-native-babel-transformer": "^0.77.0",
    "prettier": "^2.8.7",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "react-native"
  }
}
